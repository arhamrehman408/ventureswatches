{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "dist/server.cjs",
      "dist/server.cjs.map"
    ],
    "rewrites": [
      {
        "source": "/api",
        "run": {
          "serviceId": "ais-pre-4d4icdz5joalebsvoojbhx",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/**",
        "run": {
          "serviceId": "ais-pre-4d4icdz5joalebsvoojbhx",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/uploads/**",
        "run": {
          "serviceId": "ais-pre-4d4icdz5joalebsvoojbhx",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
