rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'admin@ventureswatches.com',
          'arhamrehman408@gmail.com'
        ]
      );
    }

    // Public watch catalog, collections, media assets, and CMS homepage content
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media_files/{fileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System configuration and deletion tombstones
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Price Drop Alerts:
    // Anyone can subscribe with valid email, product ID, and target price
    // Only admins can inspect, update, or remove alert requests
    match /priceDropAlerts/{alertId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.productId is string
                    && request.resource.data.targetPrice is number;
      allow read, update, delete: if isAdmin();
    }

    // Customer Orders:
    // Customers can submit orders with valid total and customer details
    // Reading orders is restricted to admins or the authenticated customer who owns the order
    // Order status changes, payment confirmation, and deletions are strictly admin-only
    match /orders/{orderId} {
      allow create: if request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.customer.name is string;
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.get(['customer', 'email'], '') == request.auth.token.email ||
          resource.data.get('userId', '') == request.auth.uid
        )
      );
      allow update, delete: if isAdmin();
    }

    // Registered User Profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
